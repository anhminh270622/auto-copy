{
  "name": "du-an",
  "private": true,
  "version": "1.0.1",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api:dev": "node server/index.js",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron . --no-sandbox\"",
    "electron:pack": "cross-env VITE_DESKTOP_BUILD=1 npm run build && electron-builder --dir",
    "electron:dist": "cross-env VITE_DESKTOP_BUILD=1 npm run build && electron-builder -w"
  },
  "dependencies": {
    "@univerjs/preset-sheets-conditional-formatting": "^0.25.1",
    "@univerjs/preset-sheets-core": "^0.25.1",
    "@univerjs/preset-sheets-data-validation": "^0.25.1",
    "@univerjs/preset-sheets-filter": "^0.25.1",
    "@univerjs/presets": "^0.25.1",
    "axios": "^1.13.5",
    "cors": "^2.8.6",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "react-toastify": "^11.0.5",
    "rxjs": "^7.8.2",
    "xlsx": "^0.18.5",
    "youtube-dl-exec": "^3.1.1",
    "youtubei.js": "^16.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.8.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "vite": "^6.3.5",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.minh.autocopy",
    "productName": "Auto Copy",
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "files": [
      "dist/index.html",
      "dist/assets/**/*",
      "dist/logo.png",
      "electron/**/*",
      "server/**/*",
      "package.json",
      "!**/*.map",
      "!dist/win-unpacked/**/*",
      "!dist/*.exe",
      "!dist/*.blockmap",
      "!node_modules/electron/**/*",
      "!node_modules/electron-builder/**/*",
      "!node_modules/@electron/**/*",
      "!node_modules/vite/**/*",
      "!node_modules/@vitejs/**/*",
      "!node_modules/esbuild/**/*",
      "!node_modules/@esbuild/**/*",
      "!node_modules/eslint/**/*",
      "!node_modules/@eslint/**/*",
      "!node_modules/eslint-*/*",
      "!node_modules/typescript/**/*",
      "!node_modules/@types/**/*",
      "!node_modules/concurrently/**/*",
      "!node_modules/wait-on/**/*",
      "!node_modules/cross-env/**/*",
      "!node_modules/youtubei.js/**/*",
      "!node_modules/@bufbuild/**/*",
      "!node_modules/react/**/*",
      "!node_modules/react-dom/**/*",
      "!node_modules/react-icons/**/*",
      "!node_modules/react-toastify/**/*",
      "!node_modules/axios/**/*"
    ],
    "asarUnpack": [
      "node_modules/youtube-dl-exec/bin/**/*"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "anhminh270622",
        "repo": "auto-copy",
        "releaseType": "release"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/anhminh270622/auto-copy.git"
  }
}
